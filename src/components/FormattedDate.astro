---
interface Props {
  date: Date;
}

const { date } = Astro.props;
if (Number.isNaN(date?.valueOf())) {
  throw new Error(`FormattedDate got an invalid date: ${date}`);
}
---

<time datetime={date.toISOString()}>
  {
    date.toLocaleDateString("en-us", {
      year: "numeric",
      month: "short",
      day: "numeric",
    })
  }
</time>
