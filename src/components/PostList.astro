---
import PostCard from "./PostCard.astro";
import { type PostListing } from "../lib/post-listing";

type Props = {
  posts: PostListing[];
};

const { posts } = Astro.props;
---

<ul>
  {
    posts.map((post, index) => (
      <li class={`post post-${post.postType}`}>
        <PostCard post={post} featured={index === 0} />
      </li>
    ))
  }
</ul>

<style>
  ul {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  ul li {
    width: 100%;
    min-width: 0;
  }
  ul li:first-child {
    margin-bottom: 2rem;
  }
  ul li:not(:first-child) {
    border-top: 1px solid rgb(var(--gray-light));
    padding-top: 0.5rem;
    padding-bottom: 0.5rem;
  }

  @media (max-width: 720px) {
    ul {
      gap: 0.5em;
    }
    ul li {
      width: 100%;
    }
    ul li:first-child {
      margin-bottom: 0;
    }
  }
</style>
