---
import { Image } from "astro:assets";
import BaseHead from "../../components/BaseHead.astro";
import Footer from "../../components/Footer.astro";
import FormattedDate from "../../components/FormattedDate.astro";
import Header from "../../components/Header.astro";
import PostNavigation from "../../components/PostNavigation.astro";
import { type ArticleWithNavigationProps } from "../../lib/article-props";
import "../../styles/article.css";
import TagIcon from "../../assets/icons/tag-janjf93-day-1727489.svg";

type Props = ArticleWithNavigationProps;

const {
  title,
  description,
  publishedAt,
  updatedAt,
  coverImage,
  tags,
  previous,
  next,
} = Astro.props;
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
    <style>
      .cover-image {
        width: 100%;
      }
      .cover-image img {
        display: block;
        margin: 0 auto;
        border-radius: 12px;
        box-shadow: var(--box-shadow);
      }
      .date {
        margin-top: 2em;
        text-align: right;
        color: rgb(var(--gray));
      }
      .tags {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        align-items: center;
        gap: 0.4em 0.6em;
        margin-bottom: 1em;
        font-size: 0.8em;
        line-height: 1.4;
        color: rgb(var(--gray));
      }

      .last-updated-on {
        font-style: italic;
      }
    </style>
  </head>

  <body>
    <Header />
    <main>
      <article>
        <div class="cover-image">
          {
            coverImage && (
              <Image width={1020} height={510} src={coverImage} alt="" />
            )
          }
        </div>
        <div class="prose">
          <div class="title">
            <h2>{title}</h2>
            {
              tags.length > 0 && (
                <div class="tags">
                  <TagIcon width={16} height={16} aria-hidden="true" />
                  {tags.map((tag) => (
                    <span class="tag">{tag}</span>
                  ))}
                </div>
              )
            }
            <hr />
          </div>
          <slot />
          <div class="date">
            <FormattedDate date={publishedAt} />
            {
              updatedAt && (
                <div class="last-updated-on">
                  Last updated on <FormattedDate date={updatedAt} />
                </div>
              )
            }
          </div>
          <PostNavigation previous={previous} next={next} />
        </div>
      </article>
    </main>
    <Footer />
  </body>
</html>
