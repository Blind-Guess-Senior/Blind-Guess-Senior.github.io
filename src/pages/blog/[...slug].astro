---
import { type CollectionEntry, render } from "astro:content";
import BlogArticle from "../../layouts/BlogArticle.astro";
import {
  toArticleProps,
  type ArticleNavigationProps,
} from "../../lib/article-props";
import { getPostCatalogEntries } from "../../lib/series-catalog";

export async function getStaticPaths() {
  const posts = await getPostCatalogEntries("blog");
  return posts.map(({ entry, routeSlug, previous, next }) => ({
    params: { slug: routeSlug },
    props: { post: entry, previous, next },
  }));
}

type Props = ArticleNavigationProps & { post: CollectionEntry<"blog"> };

const { post, previous, next } = Astro.props;
const { Content, remarkPluginFrontmatter: meta } = await render(post);

const articleProps = toArticleProps(meta, post.data, post.id, post.filePath);
---

<BlogArticle {...articleProps} previous={previous} next={next}>
  <Content />
</BlogArticle>
