---
import PostIndex from "../../layouts/PostIndex.astro";
import PostList from "../../components/PostList.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../../consts";
import { getPostListings } from "../../lib/post-listing";

const posts = await getPostListings("prose");
---

<PostIndex title={`Prose | ${SITE_TITLE}`} description={SITE_DESCRIPTION}>
  <section>
    <PostList posts={posts} />
  </section>
</PostIndex>
