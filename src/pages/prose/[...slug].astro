---
import { type CollectionEntry, getCollection, render } from "astro:content";
import ProseArticle from "../../layouts/ProseArticle.astro";
import { toArticleProps } from "../../lib/article-props";

export async function getStaticPaths() {
  const posts = await getCollection("prose");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: post,
  }));
}

type Props = CollectionEntry<"prose">;

const post = Astro.props;
const { Content, remarkPluginFrontmatter: meta } = await render(post);

const articleProps = toArticleProps(meta, post.data, post.id);
---

<ProseArticle {...articleProps}>
  <Content />
</ProseArticle>
